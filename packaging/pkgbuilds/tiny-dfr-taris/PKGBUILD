# TarisOS's patches to tiny-dfr, the Touch Bar's daemon, for whatever version Asahi's repository
# has: the modifiers held on the keyboard go with the Touch Bar's keys, so Ctrl+Alt+F1-F12 switch
# text consoles; the keyboard's backlight goes off after a minute without a key press (30 s in
# Power saver); and in Power saver the Touch Bar goes off twice as fast, counting only its own use.
# Asahi's tiny-dfr stays installed. After it (or this) is installed or upgraded, a pacman hook
# builds it again from Asahi's own packaging for the installed version with these patches on top
# (asahi-package.sh, as the kernel driver packages do with asahi-source.sh), and the service runs
# that build in place of the stock binary (a systemd drop-in). A patch that no longer applies, or
# no network, leaves the stock binary running.

pkgname=tiny-dfr-taris
epoch=1
pkgver=1.0.0
pkgrel=1
pkgdesc="TarisOS: its patches to the Touch Bar's daemon, built for the installed tiny-dfr"
arch=('aarch64')
url='https://github.com/TarisOS/tarisOS'
license=('GPL-3.0-only' 'MIT' 'Apache-2.0')
depends=('tiny-dfr' 'cargo' 'git' 'patch' 'fakeroot')
install=tiny-dfr-taris.install
source=('taris-send-held-modifiers.patch'
        'taris-touch-bar-power-saver.patch'
        'taris-unlit-keyboard.patch'
        'asahi-package.sh'
        'asahi-package.conf'
        '50-taris.conf'
        '90-taris-tiny-dfr.hook')
sha256sums=('c6f59bf203cc6d0f551f4083fd279be8186fd0a9253a80780f5c5f007e1e6076'
            'edeb55279676a780d8ad2e67e7094b32836d8e814fe1dcb6d7b5ec2547df848f'
            '43a664ebe2290941f32b7cdb2c3a9917aa216a7c08ab972dc66c47ef36c40e0d'
            'fbe31153b112e8413f08b279cb91cfa7396dfea2ec61654a349a72f1abf89cd9'
            '664792206b8464136519f115a40703e77508bb7994a4b4a99172340f1106d9ba'
            '373029df16ed390ebe2de44a3e0274ffab77d206f91fd16cdd80811c70afad4a'
            'd0923bdac4d7cc2f1a79e84180a54a01cf9b43e31c759fff96adea3eeb658859')

package() {
    local share="$pkgdir/usr/share/taris/asahi-package/tiny-dfr"
    install -Dm644 taris-*.patch asahi-package.conf -t "$share"
    install -Dm755 asahi-package.sh -t "$share"
    install -Dm644 50-taris.conf -t "$pkgdir/usr/lib/systemd/system/tiny-dfr.service.d"
    install -Dm644 90-taris-tiny-dfr.hook -t "$pkgdir/usr/share/libalpm/hooks"
}
