diff -ruN a/src/power_profile.rs b/src/power_profile.rs
--- a/src/power_profile.rs	1970-01-01 01:00:00.000000000 +0100
+++ b/src/power_profile.rs	2026-10-23 00:12:09.310725986 +0100
@@ -0,0 +1,57 @@
+use nix::{
+    errno::Errno,
+    sys::inotify::{AddWatchFlags, InitFlags, Inotify},
+};
+use std::{fs, path::PathBuf};
+
+// The power profile the user chose, as power-profiles-daemon saves it at each change (written
+// elsewhere and renamed into place); the session's own bus is out of reach of this daemon
+const PPD_STATE_DIR: &str = "/var/lib/power-profiles-daemon";
+const PPD_STATE_FILE: &str = "state.ini";
+
+fn power_saver_chosen() -> bool {
+    fs::read_to_string(PathBuf::from(PPD_STATE_DIR).join(PPD_STATE_FILE))
+        .map(|s| s.lines().any(|l| l.trim() == "Profile=power-saver"))
+        .unwrap_or(false)
+}
+
+pub struct PowerProfile {
+    watch: Option<Inotify>,
+    power_saver: bool,
+}
+
+impl PowerProfile {
+    // Without power-profiles-daemon, never Power saver
+    pub fn new() -> PowerProfile {
+        let watch = Inotify::init(InitFlags::IN_NONBLOCK).ok().filter(|watch| {
+            watch
+                .add_watch(PPD_STATE_DIR, AddWatchFlags::IN_MOVED_TO | AddWatchFlags::IN_CLOSE_WRITE)
+                .is_ok()
+        });
+        PowerProfile {
+            watch,
+            power_saver: power_saver_chosen(),
+        }
+    }
+    pub fn power_saver(&self) -> bool {
+        self.power_saver
+    }
+    // For the main loop's epoll: a change of the profile wakes it
+    pub fn fd(&self) -> Option<&Inotify> {
+        self.watch.as_ref()
+    }
+    pub fn update(&mut self) {
+        let Some(watch) = self.watch.as_ref() else {
+            return;
+        };
+        match watch.read_events() {
+            Ok(events) => {
+                if events.iter().any(|e| e.name.as_deref().is_some_and(|n| n == PPD_STATE_FILE)) {
+                    self.power_saver = power_saver_chosen();
+                }
+            }
+            Err(Errno::EAGAIN) => {}
+            Err(_) => self.watch = None,
+        }
+    }
+}
