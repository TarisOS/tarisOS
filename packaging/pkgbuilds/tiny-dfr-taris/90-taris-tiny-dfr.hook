# tiny-dfr with TarisOS's patches built again for the version just installed (asahi-package.sh)
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = tiny-dfr
Target = tiny-dfr-taris

[Action]
Description = Building tiny-dfr with TarisOS's patches for the installed version...
When = PostTransaction
Exec = /usr/share/taris/asahi-package/tiny-dfr/asahi-package.sh
