TarisOS: the keyboard's backlight goes off after a minute without a key press (30 s while the
power profile is Power saver), and back to its level at the next key
(/sys/class/leds/kbd_backlight; nothing else turns it off, and it stayed lit the whole session).
tiny-dfr already reads every keyboard on seat0 and runs as root until it drops privileges, so it
opens the backlight then, as it does the Touch Bar's. The profile comes from power-profiles-daemon's
saved state (/var/lib/power-profiles-daemon/state.ini, written at each change the user makes),
watched with inotify: this daemon can't reach the session's bus. Set off with the brightness keys,
it stays off; set by the keys while idle-off, the new level is kept. Stopped (SIGTERM, at shutdown
too) or crashed, it puts the level back first: systemd-backlight saves the keyboard's level after
tiny-dfr stops, and an idle off saved there would start the next session dark.

diff -ruN a/src/kbd_backlight.rs b/src/kbd_backlight.rs
--- a/src/kbd_backlight.rs	1970-01-01 01:00:00.000000000 +0100
+++ b/src/kbd_backlight.rs	2026-10-23 00:12:30.851973237 +0100
@@ -0,0 +1,90 @@
+use std::{
+    cmp::min,
+    fs::{self, File, OpenOptions},
+    io::Write,
+    path::PathBuf,
+    time::Instant,
+};
+
+// The keyboard's backlight goes off after a minute without a key press (30 s in Power saver), and
+// back to its level at the next one
+const KBD_BACKLIGHT_PATH: &str = "/sys/class/leds/kbd_backlight";
+const KBD_OFF_TIMEOUT_MS: u64 = 60 * 1000;
+const KBD_OFF_TIMEOUT_SAVER_MS: u64 = 30 * 1000;
+
+fn timeout_ms(power_saver: bool) -> u64 {
+    if power_saver {
+        KBD_OFF_TIMEOUT_SAVER_MS
+    } else {
+        KBD_OFF_TIMEOUT_MS
+    }
+}
+
+pub struct KbdBacklight {
+    path: PathBuf,
+    file: File,
+    last_key: Instant,
+    // The level it had when this turned it off
+    saved: Option<u32>,
+}
+
+impl KbdBacklight {
+    // Opened before privileges are dropped (the file is root's); none on Macs without one
+    pub fn new() -> Option<KbdBacklight> {
+        let path = PathBuf::from(KBD_BACKLIGHT_PATH).join("brightness");
+        let file = OpenOptions::new().write(true).open(&path).ok()?;
+        Some(KbdBacklight {
+            path,
+            file,
+            last_key: Instant::now(),
+            saved: None,
+        })
+    }
+    fn level(&self) -> u32 {
+        fs::read_to_string(&self.path)
+            .ok()
+            .and_then(|s| s.trim().parse::<u32>().ok())
+            .unwrap_or(0)
+    }
+    fn set_level(&mut self, value: u32) {
+        let _ = self.file.write_all(format!("{}\n", value).as_bytes());
+    }
+    pub fn key_pressed(&mut self) {
+        self.last_key = Instant::now();
+        self.restore();
+    }
+    // Back to the level it had, unless something else has set one since
+    pub fn restore(&mut self) {
+        if let Some(level) = self.saved.take() {
+            if self.level() == 0 {
+                self.set_level(level);
+            }
+        }
+    }
+    pub fn update(&mut self, power_saver: bool) {
+        if self.saved.is_some() {
+            // Turned on by something else (the brightness keys' brightnessctl): it counts as a key
+            if self.level() > 0 {
+                self.saved = None;
+                self.last_key = Instant::now();
+            }
+            return;
+        }
+        if self.last_key.elapsed().as_millis() as u64 >= timeout_ms(power_saver) {
+            let level = self.level();
+            // Already off (turned off with the keys): nothing to bring back
+            if level > 0 {
+                self.set_level(0);
+                self.saved = Some(level);
+            }
+        }
+    }
+    // Until it goes off, for the main loop's timeout; none while it's off
+    pub fn ms_until_off(&self, power_saver: bool) -> Option<i32> {
+        if self.saved.is_some() {
+            return None;
+        }
+        let elapsed = self.last_key.elapsed().as_millis() as u64;
+        Some(min(timeout_ms(power_saver).saturating_sub(elapsed), i32::MAX as u64) as i32)
+    }
+}
