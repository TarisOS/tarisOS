         params.set_format(alsa::pcm::Format::s16()).unwrap();
         params.set_access(alsa::pcm::Access::RWInterleaved).unwrap();
+        // TarisOS: one ALSA period per block of `period` frames, the block the loop reads and the
+        // model runs on. Left unset, ALSA takes its smallest (48 frames), and the blocking read of
+        // a block wakes at every one of them: a thousand times a second while sound plays. If it
+        // can't be set, ALSA's own choice stays, as before.
+        match params.set_period_size_near(period as alsa::pcm::Frames, alsa::ValueOr::Nearest) {
+            Ok(p) => println!("PCM period: {} frames", p),
+            Err(e) => println!("PCM period: ALSA's own ({})", e),
+        }
         pcm.hw_params(&params).unwrap();
     }
 
