+pub fn open_pcm(dev: &str, chans: u32, mut sample_rate: u32, period: usize) -> alsa::pcm::PCM {
     let pcm = alsa::pcm::PCM::new(dev, alsa::Direction::Capture, false).unwrap();
     {
         let params = alsa::pcm::HwParams::any(&pcm).unwrap();
@@ -34,6 +34,14 @@
