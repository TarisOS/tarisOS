# speakersafetyd, the speakers' protection daemon, with TarisOS's patch (taris-*.patch): its sense
# stream is read with one ALSA period per block, so it wakes about 12 times a second while sound
# plays instead of 1,000. Based on Asahi ALARM's speakersafetyd PKGBUILD (asahi-alarm/PKGBUILDs),
# with its patch (0001-*.patch); replaces that package, which a full upgrade swaps for this one.
# Keep it at Asahi's version: when theirs moves on, move this with it (pkgver, their patches,
# updpkgsums). A patch that no longer applies stops the build.

_pkgname=speakersafetyd
pkgname=speakersafetyd-taris
pkgver=2.0.1
pkgrel=1
pkgdesc='Asahi Linux speaker safety daemon, with TarisOS patches'
arch=('aarch64')
url='https://github.com/AsahiLinux/speakersafetyd'
license=('MIT')
makedepends=('rust')
depends=('alsa-lib')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
replaces=("$_pkgname")
source=(
  "$_pkgname-$pkgver.tar.gz::https://github.com/AsahiLinux/speakersafetyd/archive/$pkgver.tar.gz"
  '0001-j504-Write-the-full-speaker-names-in-conf.patch'
  'taris-sense-period.patch')
sha256sums=('0e1cb05a2f5521d80f9a502daa0b75ef5c7f2b9e8913b0f88c2d19a97d4439e5'
            '9c1060ca170f52ceb2a68fd1d3c67a31edc4171473b65c239de2115ac8c1870f'
            'e1c2c5150ffbb2856c0ebb337a683cf96446f321c81d3011bc7e0094afe80b94')

prepare() {
  cd $_pkgname-$pkgver
  patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f <../0001-j504-Write-the-full-speaker-names-in-conf.patch
  local p
  for p in ../taris-*.patch; do
    patch -p1 -s --fuzz=0 --no-backup-if-mismatch -f <"$p"
  done
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd $_pkgname-$pkgver
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd $_pkgname-$pkgver
  make DESTDIR="$pkgdir" UNITDIR=/usr/lib/systemd/system UDEVDIR=/usr/lib/udev/rules.d install
  install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
