# Updated while it's on: Tor starts again with the new rules and settings (try-restart leaves it
# off when it's off)
post_upgrade() {
    systemctl daemon-reload
    systemctl try-restart taris-tor.service
}

# Removing the package switches Tor off first, so its rules don't stay behind blocking the network
pre_remove() {
    /usr/lib/taris/tor off >/dev/null 2>&1 || true
}
