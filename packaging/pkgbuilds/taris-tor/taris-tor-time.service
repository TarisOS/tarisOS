# The time from the internet through Tor, while Tor is on (taris-tor-time.timer)

[Unit]
Description=TarisOS: the time from the internet, through Tor
Requisite=taris-tor.service
After=taris-tor.service

[Service]
Type=oneshot
ExecStart=/usr/lib/taris/tor-time
