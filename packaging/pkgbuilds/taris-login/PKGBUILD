# TarisOS's login: greetd running the shell's greeter (the lock screen, in a Hyprland of its own,
# gone once someone has logged in) or, on first boot, the setup screen (which makes the first
# account through setup-apply); the greeter's copy of the last session's look; failed-login lockout
# after 10 attempts, said on every password prompt; the keyring unlocked by the login password.
# And disk encryption, turned on from Settings: in place at the next boot, unlocked on the Plymouth
# boot screen, then autologin (the disk password is the login).

pkgname=taris-login
pkgver=1.0.0
pkgrel=4
pkgdesc='TarisOS: the login screen (greetd and the shell greeter)'
arch=('any')
url='https://github.com/TarisOS/tarisOS'
license=('GPL-3.0-only')
depends=('taris-shell' 'greetd' 'hyprland' 'gnome-keyring' 'pam' 'polkit' 'sudo' 'python' 'python-gobject' 'xkeyboard-config'
         'cryptsetup' 'plymouth' 'btrfs-progs' 'mkinitcpio' 'asahi-scripts' 'bash' 'systemd')
optdepends=('kitty: a text login if the greeter fails to start')
makedepends=('python-pillow')
backup=('etc/greetd/taris.toml')
install=taris-login.install
source=(
    'greeter'
    'greeter-session'
    'greeter-hyprland.lua'
    'greeter-sync'
    'taris-greeter-sync.service'
    'taris-greeter-sync.path'
    'taris-login.tmpfiles'
    'greetd.toml'
    'greetd-service.conf'
    'setup-apply'
    '50-taris-setup.rules'
    'sudoers-wheel'
    'autologin'
    'encrypt'
    'encrypt-initcpio-install'
    'encrypt-initcpio-hook'
    'taris-encrypt-finish.service'
    'keyring-unprotect'
    'taris.plymouth'
    'taris.script'
    'field.py'
)
sha256sums=('71427847d0d0a1f00c7836c37112fae0d1c5662fd2686f581804b87b9db97a0b'
