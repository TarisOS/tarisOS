build() {
    python3 -I field.py field.png
}

package() {
    install -Dm755 greeter greeter-session greeter-sync setup-apply autologin encrypt keyring-unprotect -t "$pkgdir/usr/lib/taris"
    install -Dm644 50-taris-setup.rules -t "$pkgdir/usr/share/polkit-1/rules.d"
    install -dm750 "$pkgdir/etc/sudoers.d"
    install -m440 sudoers-wheel "$pkgdir/etc/sudoers.d/taris-wheel"
    install -Dm644 greeter-hyprland.lua "$pkgdir/usr/share/taris/greeter/hyprland.lua"

    install -Dm644 greetd.toml "$pkgdir/etc/greetd/taris.toml"
    install -Dm644 greetd-service.conf "$pkgdir/usr/lib/systemd/system/greetd.service.d/taris.conf"
    install -Dm644 taris-login.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/taris-login.conf"

    # Disk encryption
    install -Dm644 encrypt-initcpio-install "$pkgdir/usr/lib/initcpio/install/taris-encrypt"
    install -Dm644 encrypt-initcpio-hook "$pkgdir/usr/lib/initcpio/hooks/taris-encrypt"
    install -Dm644 taris-encrypt-finish.service -t "$pkgdir/usr/lib/systemd/system"
    install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
    ln -s ../taris-encrypt-finish.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/taris-encrypt-finish.service"
    install -Dm644 taris.plymouth taris.script field.png -t "$pkgdir/usr/share/plymouth/themes/taris"

    install -Dm644 taris-greeter-sync.service taris-greeter-sync.path -t "$pkgdir/usr/lib/systemd/user"
    install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
    ln -s ../taris-greeter-sync.path "$pkgdir/usr/lib/systemd/user/default.target.wants/taris-greeter-sync.path"
    ln -s ../taris-greeter-sync.service "$pkgdir/usr/lib/systemd/user/default.target.wants/taris-greeter-sync.service"
}
