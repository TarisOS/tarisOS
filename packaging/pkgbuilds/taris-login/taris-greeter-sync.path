[Unit]
Description=Watch this account's look for the greeter

[Path]
PathChanged=%h/.local/state/taris/scheme.json
PathChanged=%h/.local/state/taris/wallpaper/path.txt
PathChanged=%h/.face
Unit=taris-greeter-sync.service

[Install]
WantedBy=default.target
