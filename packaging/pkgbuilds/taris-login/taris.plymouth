[Plymouth Theme]
Name=TarisOS
Description=Black, with the disk password field drawn like the lock screen's
ModuleName=script
Font=Rubik 13

[script]
ImageDir=/usr/share/plymouth/themes/taris
ScriptFile=/usr/share/plymouth/themes/taris/taris.script
