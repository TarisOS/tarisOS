Subject: [PATCH] wifi: brcmfmac: pcie: BCM4378 L1 substates once the firmware
 runs

On Apple's M1 Macs the BCM4378's link supports ASPM L1.1 and L1.2 on both
ends, which take about 0.2 W off the idle system, but the kernel leaves
them off: its default policy keeps the link's boot-time L1. Enabled at
runtime they held through a day of use with sleep and wake.

Enable them once the firmware is up and attached, through
pci_enable_link_state(), so the ASPM core keeps applying the policy and
states blocked through sysfs. Switch them off again at the start of every
chip reset (brcmf_pcie_reset_device(): probe, removal, the reset after a
firmware crash, and a wake that finds the firmware gone), so the firmware
always starts with L1 alone, as it does at boot and as every start that
worked in testing did.
Clock PM and the PCI-PM substates stay off.

Switch them off again when the system wakes (brcmf_pcie_pm_leave_D3()):
with them on, the firmware stopped answering a few seconds after some
wakes (scans and every command timing out until a restart); with them
blocked, every wake in testing recovered. Switch them back on 90 seconds
after a wake that found the firmware running, once it has reconnected
and settled, so the saving holds from one sleep to the next; the delayed
switch is cancelled when the system sleeps again, the chip is reset or
the device goes away.

Reloading the driver fails now and then on this chip ("FW failed to
initialize", only a restart brings the chip back) with or without these
states; this doesn't change that.
---
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
@@ -17,6 +17,7 @@
 #include <linux/io.h>
 #include <linux/random.h>
 #include <linux/unaligned.h>
+#include <linux/workqueue.h>
 
 #include <soc.h>
 #include <chipcommon.h>
@@ -427,6 +428,7 @@
 	struct brcmf_mp_device *settings;
 	struct brcmf_otp_params otp;
 	bool fwseed;
+	struct delayed_work l1ss_work;
 #ifdef DEBUG
 	u32 console_interval;
 	bool console_active;
@@ -729,6 +731,45 @@
 }
 
 
+/* The BCM4378's link may use the L1.1 and L1.2 substates of ASPM L1 once its
+ * firmware runs: about 0.2 W less at idle on a MacBook Pro M1. They are
+ * switched off again at the start of every reset of the chip (at probe,
+ * removal, a firmware crash and a wake that finds the firmware gone), so the
+ * firmware always starts as it does at boot, with L1 alone, as every start
+ * that worked in testing did, and when the machine wakes, until the firmware
+ * has settled (BRCMF_PCIE_L1SS_WAKE_DELAY). The ASPM core keeps applying the
+ * policy and any states blocked through sysfs; clock PM and the PCI-PM
+ * substates stay off.
+ */
+#define BRCMF_PCIE_L1SS_WAKE_DELAY	(90 * HZ)
+
+static void brcmf_pcie_l1ss(struct brcmf_pciedev_info *devinfo, bool enable)
+{
+	int state = PCIE_LINK_STATE_L1;
+
+	if (devinfo->pdev->device != BRCM_PCIE_4378_DEVICE_ID)
+		return;
+
+	if (enable) {
+		state |= PCIE_LINK_STATE_L1_1 | PCIE_LINK_STATE_L1_2;
+	} else {
+		/* A reset or a wake: not back on behind its back */
+		cancel_delayed_work(&devinfo->l1ss_work);
+	}
+	pci_enable_link_state(devinfo->pdev, state);
+}
+
+static void brcmf_pcie_l1ss_worker(struct work_struct *work)
+{
+	struct brcmf_pciedev_info *devinfo =
+		container_of(to_delayed_work(work), struct brcmf_pciedev_info,
+			     l1ss_work);
+
+	if (devinfo->state == BRCMFMAC_PCIE_STATE_UP)
+		brcmf_pcie_l1ss(devinfo, true);
+}
+
+
 static void brcmf_pcie_reset_device(struct brcmf_pciedev_info *devinfo)
 {
 	struct brcmf_core *core;
@@ -749,6 +790,8 @@
 	u32 val;
 	u32 lsc;
 
+	brcmf_pcie_l1ss(devinfo, false);
+
 	if (!devinfo->ci)
 		return;
 
@@ -2587,6 +2630,8 @@
 	if (ret)
 		goto fail;
 
+	brcmf_pcie_l1ss(devinfo, true);
+
 	brcmf_pcie_bus_console_read(devinfo, false);
 
 	brcmf_pcie_fwcon_timer(devinfo, true);
@@ -2834,6 +2879,7 @@
 		return ret;
 
 	devinfo->pdev = pdev;
+	INIT_DELAYED_WORK(&devinfo->l1ss_work, brcmf_pcie_l1ss_worker);
 	pcie_bus_dev = NULL;
 	devinfo->ci = brcmf_chip_attach(devinfo, pdev->device,
 					&brcmf_pcie_buscore_ops);
@@ -2965,6 +3011,7 @@
 	brcmf_pcie_fwcon_timer(devinfo, false);
 
 	devinfo->state = BRCMFMAC_PCIE_STATE_DOWN;
+	cancel_delayed_work_sync(&devinfo->l1ss_work);
 	if (devinfo->ci)
 		brcmf_pcie_intr_disable(devinfo);
 
@@ -3013,6 +3060,8 @@
 	devinfo = bus->bus_priv.pcie->devinfo;
 
 	brcmf_pcie_fwcon_timer(devinfo, false);
+	/* Asleep again before they came back: they come back after the next wake */
+	cancel_delayed_work_sync(&devinfo->l1ss_work);
 	brcmf_bus_change_state(bus, BRCMF_BUS_DOWN);
 
 	devinfo->mbdata_completed = false;
@@ -3045,6 +3094,9 @@
 	devinfo = bus->bus_priv.pcie->devinfo;
 	brcmf_dbg(PCIE, "Enter, dev=%p, bus=%p\n", dev, bus);
 
+	/* The machine woke: the link out of L1.1/L1.2 until the firmware has settled */
+	brcmf_pcie_l1ss(devinfo, false);
+
 	/* Check if device is still up and running, if so we are ready */
 	if (brcmf_pcie_read_pcie32(devinfo, devinfo->reginfo->intmask) != 0) {
 		brcmf_dbg(PCIE, "Try to wakeup device....\n");
@@ -3058,6 +3110,9 @@
 		brcmf_pcie_intr_enable(devinfo);
 		brcmf_pcie_hostready(devinfo);
 		brcmf_pcie_fwcon_timer(devinfo, true);
+		if (devinfo->pdev->device == BRCM_PCIE_4378_DEVICE_ID)
+			schedule_delayed_work(&devinfo->l1ss_work,
+					      BRCMF_PCIE_L1SS_WAKE_DELAY);
 		return 0;
 	}
 
