prepare() {
    local f
    rm -rf brcm80211
    mkdir -p brcm80211/brcmfmac/{wcc,cyw,bca} brcm80211/include
    for f in "${_files[@]}"; do
        cp "$_tag-${f//\//-}" "brcm80211/$f"
    done
    # The change is against the whole kernel tree (drivers/net/wireless/broadcom/brcm80211/...)
    patch -d brcm80211 -Np6 <0001-wifi-brcmfmac-pcie-BCM4378-L1-substates-only-while-the-firmware-runs.patch
    # The changed file says so
    patch -d brcm80211 -Np1 <taris-notices.patch
}

package() {
    local dir
    grep -qx "PACKAGE_VERSION=\"$pkgver\"" dkms.conf || {
        error "dkms.conf isn't for $pkgver"
        return 1
    }
    for dir in brcmfmac brcmfmac/wcc brcmfmac/cyw brcmfmac/bca include; do
        install -Dm644 brcm80211/$dir/*.[ch] -t "$pkgdir/usr/src/taris-brcmfmac-$pkgver/$dir"
    done
    for dir in brcmfmac brcmfmac/wcc brcmfmac/cyw brcmfmac/bca; do
        install -Dm644 brcm80211/$dir/Makefile -t "$pkgdir/usr/src/taris-brcmfmac-$pkgver/$dir"
    done
    install -Dm644 dkms.conf -t "$pkgdir/usr/src/taris-brcmfmac-$pkgver"
    # What TarisOS changed, with the source and on its own
    install -Dm644 NOTICE -t "$pkgdir/usr/src/taris-brcmfmac-$pkgver"
    install -Dm644 NOTICE -t "$pkgdir/usr/share/licenses/$pkgname"
}
