# The M1 Macs' Wi-Fi link in its deeper sleep states (ASPM L1.1 and L1.2) while the firmware runs,
# about 0.2 W less at idle: the Broadcom Wi-Fi driver (brcmfmac), from the source of the kernel
# TarisOS runs (Asahi Linux's asahi-7.1.13-3, as asahi-alarm's linux-asahi builds it), with
# TarisOS's change. The kernel leaves those states off; the driver switches them on once the
# firmware is up and off again before every reset of the chip, so the firmware always starts with
# L1 alone, as at boot. DKMS builds it, with the three firmware-vendor modules that use its
# exports, for that kernel only (dkms.conf): a kernel from newer source keeps its own driver, and
# the link stays in L1 until this package moves to that source (pkgver is the source's tag;
# dkms.conf names the same version and kernel).

pkgname=taris-brcmfmac-dkms
pkgver=7.1.13.3
pkgrel=1
_tag=asahi-7.1.13-3
pkgdesc='TarisOS: the Broadcom Wi-Fi driver with the M1 Wi-Fi link in deeper sleep, for DKMS'
arch=('aarch64')
url='https://github.com/AsahiLinux/linux'
license=('ISC')
depends=('dkms' 'linux-asahi-headers')
_files=(brcmfmac/Makefile brcmfmac/acpi.c brcmfmac/bcdc.c brcmfmac/bcdc.h brcmfmac/bcmsdh.c brcmfmac/btcoex.c brcmfmac/btcoex.h brcmfmac/bus.h brcmfmac/cfg80211.c brcmfmac/cfg80211.h brcmfmac/chip.c brcmfmac/chip.h brcmfmac/common.c brcmfmac/common.h brcmfmac/commonring.c brcmfmac/commonring.h brcmfmac/core.c brcmfmac/core.h brcmfmac/debug.c brcmfmac/debug.h brcmfmac/dmi.c brcmfmac/feature.c brcmfmac/feature.h brcmfmac/firmware.c brcmfmac/firmware.h brcmfmac/flowring.c brcmfmac/flowring.h brcmfmac/fweh.c brcmfmac/fweh.h brcmfmac/fwil.c brcmfmac/fwil.h brcmfmac/fwil_types.h brcmfmac/fwsignal.c brcmfmac/fwsignal.h brcmfmac/fwvid.c brcmfmac/fwvid.h brcmfmac/interface_create.c brcmfmac/interface_create.h brcmfmac/join_param.c brcmfmac/join_param.h brcmfmac/msgbuf.c brcmfmac/msgbuf.h brcmfmac/of.c brcmfmac/of.h brcmfmac/p2p.c brcmfmac/p2p.h brcmfmac/pcie.c brcmfmac/pcie.h brcmfmac/pno.c brcmfmac/pno.h brcmfmac/proto.c brcmfmac/proto.h brcmfmac/ratespec.h brcmfmac/scan_param.c brcmfmac/scan_param.h brcmfmac/sdio.c brcmfmac/sdio.h brcmfmac/tracepoint.c brcmfmac/tracepoint.h brcmfmac/usb.c brcmfmac/usb.h brcmfmac/vendor.c brcmfmac/vendor.h brcmfmac/xtlv.c brcmfmac/xtlv.h brcmfmac/wcc/Makefile brcmfmac/wcc/core.c brcmfmac/wcc/module.c brcmfmac/wcc/vops.h brcmfmac/cyw/Makefile brcmfmac/cyw/core.c brcmfmac/cyw/fwil_types.h brcmfmac/cyw/module.c brcmfmac/cyw/vops.h brcmfmac/bca/Makefile brcmfmac/bca/core.c brcmfmac/bca/module.c brcmfmac/bca/vops.h include/brcm_hw_ids.h include/brcmu_d11.h include/brcmu_utils.h include/brcmu_wifi.h include/chipcommon.h include/defs.h include/soc.h)
