# TarisOS's wallpapers (this repository's packaging/wallpapers: numbered WebP files sized to cover
# a 2560x1600 screen). Each account's wallpaper folder links to them (taris-desktop's
# user-defaults).

pkgname=taris-wallpapers
pkgver=1.0.0
pkgrel=3
pkgdesc='TarisOS: wallpapers'
arch=('any')
url='https://github.com/TarisOS/tarisOS'
license=('GPL-3.0-only')

_packaging="${TARIS_PACKAGING:-$startdir/../..}"

package() {
    install -Dm644 "$_packaging"/wallpapers/*.webp -t "$pkgdir/usr/share/backgrounds/taris"
}
