# Hardware video decoding on Apple Silicon: a VA-API driver for the Apple Video Decoder (AVD, a
# stateless V4L2 decoder; its firmware is avd-fw). libva picks a driver by the GPU's DRM driver
# name, "asahi", so it's installed under that name as well. mpv, ffmpeg and GStreamer use it with
# nothing to set up; it spends about 84% less CPU time on decoding. Pinned to a tested commit.

pkgname=libva-v4l2-request-avd
_commit=5b5046cbda6892f4a63df0015857a80bd42c17cf
pkgver=1.3.r11.g5b5046c
pkgrel=1
pkgdesc='VA-API driver for the Apple Video Decoder (hardware video decoding on Apple Silicon)'
arch=('aarch64')
url='https://github.com/iconidentify/libva-v4l2_request'
license=('GPL-3.0-or-later')
depends=('glibc' 'libva' 'libdrm' 'avd-fw')
makedepends=('git' 'meson' 'linux-api-headers')
provides=('libva-v4l2-request')
conflicts=('libva-v4l2-request')
source=("libva-v4l2_request::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

build() {
    arch-meson libva-v4l2_request build
    meson compile -C build
}

package() {
    DESTDIR="$pkgdir" meson install -C build
    ln -s v4l2_request_drv_video.so "$pkgdir/usr/lib/dri/asahi_drv_video.so"
    install -Dm644 libva-v4l2_request/COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
