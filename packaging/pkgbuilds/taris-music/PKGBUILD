# Taris Music, TarisOS's music player ("Music"): this repository's music folder, Zuno 1.4.0
# (YouTube Music as a desktop app; Apache-2.0, github.com/noFAYZ/zuno) modified for TarisOS
# (music/NOTICE). Tauri: its interface in WebKitGTK, its Rust side playing the music (two decks,
# for gapless and crossfade) without YouTube's player or its ads, which only takes over a stream
# Rust is refused. Built for 64-bit ARM. Its launcher opens it as the music workspace over
# everything (TarisOS's Hyprland config).
#
# Its sound goes out through cpal 0.17.3 (rodio's ALSA output) with TarisOS's patch
# (taris-cpal-xrun-recovery.patch, cpal 0.18's fix backported). After an underrun, pipewire-alsa
# reports POLLERR until the stream is prepared again; cpal 0.17 returned an error on it instead of
# recovering, so its audio thread spun at 100% of a core, playing silence until the app was quit.
# Drop the patch when Taris Music moves to rodio 0.23 (cpal 0.18.2); with another cpal in
# Cargo.lock the build stops.
#
# TARIS_SRC=/path/to/music builds another checkout's music folder.

pkgname=taris-music
pkgver=1.4.0
pkgrel=4
pkgdesc='The TarisOS music player (YouTube Music), based on Zuno'
arch=('aarch64')
url='https://github.com/TarisOS/tarisOS'
license=('Apache-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'gst-plugins-base' 'gst-plugins-good' 'gst-libav'
    'alsa-lib' 'dbus' 'openssl' 'glib2' 'hicolor-icon-theme')
makedepends=('rust' 'nodejs' 'npm')
optdepends=('gst-plugins-bad: more containers and codecs' 'xdg-utils: opening links from inside the app')
provides=('zuno')
conflicts=('zuno')
replaces=('zuno')
source=('taris-music.desktop'
        'taris-cpal-xrun-recovery.patch')
sha256sums=('e23337a054bd2a9b5451a20411060fcfff055ebf94830f8075f0d98c652d8cc0'
            'ccb8b85ef94b0f87c196737abbfb31f34775ac29f30485c717ee8e98ca89c2ba')

_src() {
    echo "${TARIS_SRC:-$startdir/../../../music}"
}

prepare() {
    # A copy to build in (npm and cargo write into the tree), without a checkout's build output
    rm -rf "$srcdir/music"
    mkdir "$srcdir/music"
    tar -C "$(_src)" --exclude=./node_modules --exclude=./dist --exclude=./src-tauri/target \
        --exclude=./src-tauri/gen -cf - . | tar -C "$srcdir/music" -xf -
    cd "$srcdir/music"
    npm ci

    # cpal with TarisOS's patch (see the top), in place of crates.io's through cargo's [patch]
    # table, from a config file the build finds above src-tauri
    export CARGO_HOME="$srcdir/cargo"
    cargo fetch --locked --manifest-path src-tauri/Cargo.toml
    local cpal=("$CARGO_HOME"/registry/src/*/cpal-0.17.3)
    if [[ ! -d ${cpal[0]} ]]; then
        echo "Cargo.lock has no cpal 0.17.3 any more: update or drop taris-cpal-xrun-recovery.patch" >&2
        return 1
    fi
    rm -rf "$srcdir/cpal"
    cp -r "${cpal[0]}" "$srcdir/cpal"
    patch -d "$srcdir/cpal" -p1 -s --fuzz=0 --no-backup-if-mismatch -f <"$srcdir/taris-cpal-xrun-recovery.patch"
    mkdir -p .cargo
    printf '[patch.crates-io]\ncpal = { path = "%s" }\n' "$srcdir/cpal" >.cargo/config.toml
}

build() {
    cd "$srcdir/music"
    export CARGO_HOME="$srcdir/cargo"
    # The program only (no .deb or AppImage bundles)
    npm run tauri build -- --no-bundle
}

package() {
    cd "$srcdir/music"
    install -Dm755 src-tauri/target/release/taris-music -t "$pkgdir/usr/bin"
    install -Dm644 "$srcdir/taris-music.desktop" -t "$pkgdir/usr/share/applications"
    local size
    for size in 32 64 128; do
        install -Dm644 "src-tauri/icons/${size}x$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x$size/apps/taris-music.png"
    done
    install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/taris-music.png"
    install -Dm644 LICENSE NOTICE -t "$pkgdir/usr/share/licenses/$pkgname"
}
