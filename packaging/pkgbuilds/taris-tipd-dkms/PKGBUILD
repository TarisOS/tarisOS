# A display on the M1 Macs' USB-C (with taris-hardware's usb-c-display): the USB-C controller's
# driver (tipd) with Janne Grunau's two DP alt-mode commits from Asahi Linux's work-in-progress
# branches. They tell the display driver when a display on USB-C comes and goes, which the kernel's
# own driver never does. No kernel source in the package: DKMS builds it for every Asahi Linux
# kernel installed, and before each build asahi-source.sh fetches that kernel's driver source and
# applies the commits (dkms.conf). A kernel whose source they don't apply to keeps its own driver,
# and the USB-C display stays dark until the commits are brought up to date.

pkgname=taris-tipd-dkms
epoch=1
pkgver=1.0.0
pkgrel=1
pkgdesc="TarisOS: the USB-C controller's driver with DisplayPort alt mode, for DKMS"
arch=('aarch64')
url='https://github.com/AsahiLinux/linux'
license=('GPL-2.0-only')
depends=('dkms' 'linux-asahi-headers' 'git' 'patch')
source=('0001-usb-typec-tipd-Track-data_status-changes-for-CD321x.patch'
        '0002-usb-typec-tipd-HACK-Use-drm-oob-hotplug-event.patch'
        'taris-notices.patch'
        'asahi-source.sh'
        'asahi-source.conf'
        'dkms.conf'
        'NOTICE')
sha256sums=('5526af5e4116b80bfe9f31a2ef6bc3d65ff7e444febc9d69f89232a06d0c8060'
            '5d8f9f10e6d7cd309af76ce23856b37832b74fc83399d998e7563f26cee24db8'
            '308097104b77fff8a113fbf2e7e058c4e343128c2b360e7705eb78781941b03f'
            '333e32aa08b1ddf108ea25486996a249e48373b3c118ffe3bff0c7b07469862c'
            '6196a5dfbc759e05bae6c9cd467523b1a7a0e8b8a6a0f2a4a1ccf092006d7a58'
            '73309c7b63157082bba60a1bc50acbb07b65a072e05db6341a87db23d10f2426'
            '933ba2045bf1c459a6c7b7314b4657cc9fbd0d36d337c0de8818841622c83113')

package() {
    local src="$pkgdir/usr/src/taris-tipd-$pkgver"
    grep -qx "PACKAGE_VERSION=\"$pkgver\"" dkms.conf || {
        error "dkms.conf isn't for $pkgver"
        return 1
    }
    install -Dm644 ./*.patch asahi-source.conf dkms.conf NOTICE -t "$src"
    install -Dm755 asahi-source.sh -t "$src"
    install -Dm644 NOTICE -t "$pkgdir/usr/share/licenses/$pkgname"
}
