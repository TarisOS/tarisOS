# m1n1's boot image with the device trees that have the USB-C display (usb-c-display). They replace
# the copies 1.0.0-4 left in /var/lib/taris/dtbs (with CPU and GPU temperature sensors the Macs'
# SMCs don't have)
post_install() {
    /usr/lib/taris/usb-c-display
    /usr/bin/update-m1n1
    touchbar_default
    wifi_power
}

# The Touch Bar's settings: /var/lib/taris/touchbar/config.toml, made from TarisOS's
# (/usr/share/taris/tiny-dfr) when there's none, and handed to the owner account by
# touchbar-owner; /etc/tiny-dfr/config.toml links to it. Older versions installed that /etc file
# themselves: pacman has removed it, keeping an edited one as config.toml.pacsave, which is taken
# up instead.
touchbar_default() {
    local file=/var/lib/taris/touchbar/config.toml from=/usr/share/taris/tiny-dfr/config.toml
    if [[ ! -e $file ]]; then
        [[ -f /etc/tiny-dfr/config.toml.pacsave ]] && from=/etc/tiny-dfr/config.toml.pacsave
        install -Dm644 "$from" "$file"
    fi
    [[ $(readlink /etc/tiny-dfr/config.toml) == "$file" ]] || ln -sfn "$file" /etc/tiny-dfr/config.toml
}

# The Wi-Fi's wake time after traffic, for the interfaces up now: NetworkManager's dispatcher
# (50-taris-wifi-power) sets it at every connection from then on. "default" before removal puts
# the driver's choice back while the helper is still there. Never in a chroot: the image build's
# arch-chroot shares the build machine's /sys and network, whose Wi-Fi isn't TarisOS's to change.
wifi_power() {
    local dir dev
    if ! systemd-detect-virt -q --chroot; then
        for dir in /sys/class/net/*/wireless; do
            dev=${dir%/wireless}
            dev=${dev##*/}
            if [[ -d $dir && $(<"/sys/class/net/$dev/operstate") == "up" ]]; then
                /usr/lib/taris/wifi-power-timeout "$dev" "$@" || true
            fi
        done
    fi
}

# systemd-networkd off, as the image means it to be (80-taris.preset keeps it off at a new
# install's first boot): its preset applied to each of its units, then all of them stopped in one
# go, so a socket can't start the service again in between (not in a chroot, where nothing runs).
# Once, when upgrading from a version without the preset; later upgrades leave it as the
# administrator has it. The preset unit by unit: a masked one (wait-online, masked by the image)
# makes systemctl preset fail.
networkd_off() {
    local unit units=(systemd-networkd.service systemd-networkd.socket
        systemd-networkd-varlink.socket systemd-networkd-varlink-metrics.socket
        systemd-networkd-resolve-hook.socket systemd-networkd-wait-online.service
        systemd-network-generator.service)
    for unit in "${units[@]}"; do
        systemctl preset "$unit" 2>/dev/null || true
    done
    if ! systemd-detect-virt -q --chroot; then
        systemctl stop "${units[@]}" 2>/dev/null || true
    fi
}

post_upgrade() {
    post_install
    if (( $(vercmp "$2" 1.0.0-8) < 0 )); then
        networkd_off
    fi
}

pre_remove() {
    wifi_power default
}

# The kernel's own device trees again, and tiny-dfr's own settings (the machine's are kept in
# /var/lib/taris/touchbar)
post_remove() {
    rm -rf /var/lib/taris/dtbs
    /usr/bin/update-m1n1
    [[ -L /etc/tiny-dfr/config.toml ]] && rm -f /etc/tiny-dfr/config.toml
    true
}
