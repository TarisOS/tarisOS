# The built-in microphone for every app (taris-mic.service, each time PipeWire's PulseAudio server
# starts). Asahi's microphone (the mic array through its DSP) is one channel without a position
# (AUX0): an app recording in stereo gets it on the left only. A mono copy of it, which apps get on
# both channels, is the preferred source. Macs without the DSP microphone are left alone.
set -u

name=taris_mic
for ((i = 0; i < 30; i++)); do
	sources=$(pactl list short sources 2>/dev/null) || {
		sleep 1
		continue
	}
	awk -v n="$name" '$2 == n { found = 1 } END { exit !found }' <<<"$sources" && exit 0
	dsp=$(awk '$2 ~ /^effect_output\.j[0-9]+-mic$/ { print $2; exit }' <<<"$sources")
	if [[ -n $dsp ]]; then
		exec pactl load-module module-remap-source "source_name=$name" "master=$dsp" channels=1 channel_map=mono \
			'source_properties="device.description=\"Built-in Microphone\" device.icon-name=audio-input-microphone priority.session=2010"' >/dev/null
	fi
	sleep 1
done
