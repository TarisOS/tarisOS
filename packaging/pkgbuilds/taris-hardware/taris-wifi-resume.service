# After each resume, started by wifi-resume's systemd-sleep hook as a job of its own, which a reboot
# or shutdown can cancel (ordered after suspend.target, so it never holds the resume up)
[Unit]
Description=Recover Wi-Fi after resume
After=suspend.target NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/lib/taris/wifi-resume
TimeoutStartSec=120
