# TarisOS's Apple Silicon hardware support: the drivers' user-space parts and the fixes this
# hardware needs on top of Asahi Linux. Every fix is a file of this package, so updates reach
# installed machines and removing it undoes them.

pkgname=taris-hardware
pkgver=1.0.0
pkgrel=9
pkgdesc='TarisOS: Apple Silicon hardware support and fixes'
arch=('aarch64')
url='https://github.com/TarisOS/tarisOS'
license=('GPL-3.0-only')
depends=(
    # Asahi Linux: kernel, boot loader, firmware, the Touch Bar, the video decoder's firmware
    'asahi-meta'
    'avd-fw'
    'mkinitcpio'
    'grub'

    # Sound: the speakers stay muted without speakersafetyd and asahi-audio's DSP; PipeWire's
    # PulseAudio, ALSA and JACK servers for the apps, and its LV2 host for the DSP's plugins (the
    # other providers of jack and lv2-host are whole audio workstations); rtkit, or the DSP crackles
    # under load; libmysofa's head (HRTF) for spatial audio on headphones; LSP's compressor and
    # limiter for the MacBook Pro 13" speakers (spatial-audio.lua)
    'asahi-audio'
    'speakersafetyd'
    'pipewire'
    'pipewire-pulse'
    'pipewire-alsa'
    'pipewire-jack'
    'pipewire-audio'
    'wireplumber'
    'rtkit'
    'libpulse'
    'libmysofa'
    'lsp-plugins-lv2'

    # Hardware video decoding (VA-API)
    'libva-v4l2-request-avd'

    # More external displays than the chip's own outputs, through Silicon Motion's USB display
    # adapters (with evdi, which DKMS builds for each kernel from its headers)
    'smi-usbdisplay-taris'

    # A display on the M1's USB-C: the USB-C controller's driver that tells the display driver it's
    # there (usb-c-display switches the rest on)
    'taris-tipd-dkms'

    # ...and the display driver that survives a USB-C display being unplugged while on
    'taris-appledrm-dkms'

    # The Wi-Fi driver that puts the M1 Wi-Fi's PCIe link in its deeper sleep states while the
    # firmware runs
    'taris-brcmfmac-dkms'

    # The Bluetooth driver that still answers after waking from sleep
    'taris-bcm4377-dkms'

    # Wi-Fi (NetworkManager alone; its regulatory domain) and Bluetooth
    'networkmanager'
    'wireless-regdb'
    'iw'
    'bluez'
    'bluez-utils'

    # Compressed swap in RAM; systemd-oomd (part of systemd) stops the app that fills it
    'zram-generator'

    # A readable console font on Retina screens (the decrypt prompt, TTYs)
    'terminus-font'

    'bash'
    'python'
    'kmod'
    'systemd'
    'polkit'
)
install=taris-hardware.install
backup=(
    'etc/mkinitcpio.conf.d/taris-hid.conf'
    'etc/default/grub.d/taris.cfg'
    'etc/default/update-m1n1'
    'etc/mkinitcpio.conf.d/taris-usb-c-display.conf'
)
source=(
    'zram.conf'
    '50-taris-oomd.conf'
    'taris-hid.conf'
    'taris-grub.cfg'
    'grub-background.png'
    'taris-initramfs.hook'
    'taris-grub.hook'
    'wifi-resume'
    'taris-wifi-resume.service'
    'regdom'
    'taris-regdom.service'
    'mic'
    'taris-mic.service'
    '90-taris-fans.rules'
    'fans-auto'
    '90-taris-battery.rules'
    'tiny-dfr.toml'
    'tiny-dfr-screenshot.png'
    'camera'
    '50-taris-camera.rules'
    'spatial-audio.lua'
    '99-taris-spatial-audio.conf'
    'tiny-dfr-pause'
    'taris-tiny-dfr-pause.hook'
    'taris-tiny-dfr-resume.hook'
    'usb-c-display'
    'taris-usb-c-display.hook'
    'update-m1n1'
    'taris-usb-c-display.conf'
    'touchbar-owner'
    '50-taris-power.conf'
    '50-taris-audit.conf'
    'wifi-power-timeout'
    '50-taris-wifi-power'
    '80-taris.preset'
)
