            'fe36577c0dc5a1f7556d78bba16c7ced051e5a7a2d9b721a2d2cdb98d2134c70')

package() {
    install -Dm644 zram.conf "$pkgdir/usr/lib/systemd/zram-generator.conf.d/50-taris.conf"
    # The app that fills the memory stopped before the desktop freezes: systemd-oomd watching the
    # accounts' apps, on whenever installed (the install script starts it at once)
    install -Dm644 50-taris-oomd.conf -t "$pkgdir/usr/lib/systemd/system/user@.service.d"
    install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants" "$pkgdir/usr/lib/systemd/system/sockets.target.wants"
    ln -s ../systemd-oomd.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/systemd-oomd.service"
    ln -s ../systemd-oomd.socket "$pkgdir/usr/lib/systemd/system/sockets.target.wants/systemd-oomd.socket"
    install -Dm644 taris-hid.conf "$pkgdir/etc/mkinitcpio.conf.d/taris-hid.conf"
    install -Dm644 taris-grub.cfg "$pkgdir/etc/default/grub.d/taris.cfg"
    install -Dm644 grub-background.png "$pkgdir/usr/share/taris/grub-background.png"
    install -Dm644 taris-initramfs.hook "$pkgdir/usr/share/libalpm/hooks/90-taris-initramfs.hook"
    install -Dm644 taris-grub.hook "$pkgdir/usr/share/libalpm/hooks/91-taris-grub.hook"

    # Power: real-time threads without full boost and no proactive compaction (systemd's sysctl
    # hook applies them as soon as they're installed); no kernel auditing (from the next boot)
    install -Dm644 50-taris-power.conf -t "$pkgdir/usr/lib/sysctl.d"
    install -Dm644 50-taris-audit.conf -t "$pkgdir/usr/lib/systemd/journald.conf.d"

    install -Dm755 wifi-resume "$pkgdir/usr/lib/taris/wifi-resume"
    # The Wi-Fi radio's wake time after traffic (TarisOS's 200 ms instead of the driver's 2 s), at
    # every connection
    install -Dm755 wifi-power-timeout "$pkgdir/usr/lib/taris/wifi-power-timeout"
    install -Dm755 50-taris-wifi-power -t "$pkgdir/usr/lib/NetworkManager/dispatcher.d"
    # NetworkManager alone: systemd-networkd stays off, also at a new install's first boot
    install -Dm644 80-taris.preset -t "$pkgdir/usr/lib/systemd/system-preset"
    install -Dm755 regdom "$pkgdir/usr/lib/taris/regdom"
    install -Dm644 taris-wifi-resume.service taris-regdom.service -t "$pkgdir/usr/lib/systemd/system"
    # On whenever installed (no enabling step to forget, nothing left behind when removed)
    install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
    ln -s ../taris-regdom.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/taris-regdom.service"
    # Wi-Fi's recovery after waking, started by systemd-sleep (wifi-resume post) as a job of its own
    install -d "$pkgdir/usr/lib/systemd/system-sleep"
    ln -s ../../../lib/taris/wifi-resume "$pkgdir/usr/lib/systemd/system-sleep/taris-wifi-resume"

    # The built-in microphone on both channels, with the user's PulseAudio server
    install -Dm755 mic "$pkgdir/usr/lib/taris/mic"
    install -Dm644 taris-mic.service -t "$pkgdir/usr/lib/systemd/user"
    install -d "$pkgdir/usr/lib/systemd/user/pipewire-pulse.service.wants"
    ln -s ../taris-mic.service "$pkgdir/usr/lib/systemd/user/pipewire-pulse.service.wants/taris-mic.service"

    install -Dm644 90-taris-fans.rules 90-taris-battery.rules -t "$pkgdir/usr/lib/udev/rules.d"
    install -Dm755 fans-auto "$pkgdir/usr/lib/taris/fans-auto"

    # The camera's switch (the Camera quick toggle)
    install -Dm755 camera "$pkgdir/usr/lib/taris/camera"
    install -Dm644 50-taris-camera.rules -t "$pkgdir/usr/share/polkit-1/rules.d"

    # Spatial audio: crosstalk cancellation on the speakers, virtual speakers on headphones; the
    # MacBook Pro 13" speakers' compressor and limiter against clipping at full volume
    install -Dm644 spatial-audio.lua "$pkgdir/usr/share/wireplumber/scripts/taris/spatial-audio.lua"
    install -Dm644 99-taris-spatial-audio.conf -t "$pkgdir/usr/share/wireplumber/wireplumber.conf.d"

    # The Touch Bar's keys (MacBook Pros with one): media and brightness keys and a screenshot key.
    # TarisOS's settings, which the machine's own start from: those are
    # /var/lib/taris/touchbar/config.toml (the install script), which /etc/tiny-dfr/config.toml links
    # to, handed to the owner account (touchbar-owner)
    install -Dm644 tiny-dfr.toml "$pkgdir/usr/share/taris/tiny-dfr/config.toml"
    install -Dm755 touchbar-owner "$pkgdir/usr/lib/taris/touchbar-owner"
    install -Dm644 tiny-dfr-screenshot.png "$pkgdir/etc/tiny-dfr/screenshot.png"
    # Stopped while those files change, which it can't take (tiny-dfr-pause)
    install -Dm755 tiny-dfr-pause "$pkgdir/usr/lib/taris/tiny-dfr-pause"
    install -Dm644 taris-tiny-dfr-pause.hook taris-tiny-dfr-resume.hook -t "$pkgdir/usr/share/libalpm/hooks"

    # A display on the M1's USB-C: the kernel's device trees with it switched on, made again before
    # m1n1's hook builds the boot image (94-, before 95-m1n1-install) and taken by update-m1n1; the
    # display crossbar's driver in the initramfs
    install -Dm755 usb-c-display "$pkgdir/usr/lib/taris/usb-c-display"
    install -Dm644 taris-usb-c-display.hook "$pkgdir/usr/share/libalpm/hooks/94-taris-usb-c-display.hook"
    install -Dm644 update-m1n1 "$pkgdir/etc/default/update-m1n1"
    install -Dm644 taris-usb-c-display.conf "$pkgdir/etc/mkinitcpio.conf.d/taris-usb-c-display.conf"
}
