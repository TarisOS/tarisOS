[Unit]
Description=Set the Wi-Fi regulatory domain from the timezone
ConditionPathExists=/etc/localtime
After=local-fs.target
Before=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/lib/taris/regdom

[Install]
WantedBy=multi-user.target
