# The initramfs again when TarisOS's mkinitcpio settings change
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = etc/mkinitcpio.conf.d/taris-*.conf

[Action]
Description = Rebuilding the initramfs for TarisOS's settings...
When = PostTransaction
Depends = mkinitcpio
Exec = /usr/bin/mkinitcpio -P
