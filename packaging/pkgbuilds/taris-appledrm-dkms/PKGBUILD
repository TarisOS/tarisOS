# A USB-C display that can be unplugged while on: the Apple display driver (appledrm), from the
# source of the kernel TarisOS runs (Asahi Linux's asahi-7.1.13-3, as asahi-alarm's linux-asahi
# builds it), with Christian Bartels's fix for its power-off. Unplugged while on, the display
# processor can answer the last clear swap late; the kernel's own driver then marks it crashed and
# refuses every later modeset until a reboot. DKMS builds it for that kernel only (dkms.conf): a
# kernel from newer source keeps its own driver (pkgver is the source's tag; dkms.conf names the same
# version and kernel).

pkgname=taris-appledrm-dkms
pkgver=7.1.13.3
pkgrel=1
_tag=asahi-7.1.13-3
pkgdesc='TarisOS: the Apple display driver that survives unplugging a USB-C display, for DKMS'
arch=('aarch64')
url='https://github.com/AsahiLinux/linux'
license=('GPL-2.0-only')
depends=('dkms' 'linux-asahi-headers')
