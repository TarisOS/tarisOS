# A USB-C display that can be unplugged while on: the Apple display driver (appledrm) with
# Christian Bartels's fix for its power-off. Unplugged while on, the display processor can answer
# the last clear swap late; the kernel's own driver then marks it crashed and refuses every later
# modeset until a reboot. No kernel source in the package: DKMS builds it for every Asahi Linux
# kernel installed, and before each build asahi-source.sh fetches that kernel's driver source and
# applies the fix (dkms.conf). A kernel whose source it doesn't apply to keeps its own driver.

pkgname=taris-appledrm-dkms
epoch=1
pkgver=1.0.0
pkgrel=1
pkgdesc="TarisOS: the Apple display driver that survives unplugging a USB-C display, for DKMS"
arch=('aarch64')
url='https://github.com/AsahiLinux/linux'
license=('GPL-2.0-only')
depends=('dkms' 'linux-asahi-headers' 'git' 'patch')
source=('0001-drm-apple-a-late-clear-swap-at-power-off-is-not-a-DCP-crash.patch'
        'taris-notices.patch'
        'asahi-source.sh'
        'asahi-source.conf'
        'dkms.conf'
        'NOTICE')
sha256sums=('850f2d91e29c8257ea0cfe1cfef42e1f995f133ec6d088cac981fbab1ae16575'
            'fa592d6fe21a93d74634d1a2fb02c877ed0ab7a0dd83015aaf12a2e2ead994d3'
            '333e32aa08b1ddf108ea25486996a249e48373b3c118ffe3bff0c7b07469862c'
            'a570ea9e1e57b1b0e1e72c27423723c1b3aa27d5637abb7f0710408c38065d25'
            'ce7e47069dfb7fab268d4d9de36c9d62f0856bd6813988b09f8f5011a26567b4'
            'c9a21b15869bf5930d170577d0caa15b6ac9b4f84198d511f1e865ad7c0766e6')

package() {
    local src="$pkgdir/usr/src/taris-appledrm-$pkgver"
    grep -qx "PACKAGE_VERSION=\"$pkgver\"" dkms.conf || {
        error "dkms.conf isn't for $pkgver"
        return 1
    }
    install -Dm644 ./*.patch asahi-source.conf dkms.conf NOTICE -t "$src"
    install -Dm755 asahi-source.sh -t "$src"
    install -Dm644 NOTICE -t "$pkgdir/usr/share/licenses/$pkgname"
}
