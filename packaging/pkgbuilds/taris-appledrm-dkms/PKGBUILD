prepare() {
    local f
    rm -rf apple
    mkdir -p apple/epic
    for f in "${_files[@]}"; do
        cp "$_tag-${f//\//-}" "apple/$f"
    done
    # The commit is against the whole kernel tree (drivers/gpu/drm/apple/...)
    patch -d apple -Np5 <0001-drm-apple-a-late-clear-swap-at-power-off-is-not-a-DCP-crash.patch
    # The changed file says so (GPL-2.0 section 2a)
    patch -d apple -Np1 <taris-notices.patch
}

package() {
    grep -qx "PACKAGE_VERSION=\"$pkgver\"" dkms.conf || {
        error "dkms.conf isn't for $pkgver"
        return 1
    }
    install -Dm644 apple/*.[ch] apple/Makefile dkms.conf -t "$pkgdir/usr/src/taris-appledrm-$pkgver"
    install -Dm644 apple/epic/* -t "$pkgdir/usr/src/taris-appledrm-$pkgver/epic"
    # What TarisOS changed, with the source and on its own
    install -Dm644 NOTICE -t "$pkgdir/usr/src/taris-appledrm-$pkgver"
    install -Dm644 NOTICE -t "$pkgdir/usr/share/licenses/$pkgname"
}
