 }
 
 void IdleMonitor::updateNotification() {
@@ -31,7 +26,18 @@ void IdleMonitor::updateNotification() {
 	delete notification;
 	notification = nullptr;
 
-	auto guard = qScopeGuard([&, this] { this->bNotification = notification; });
+	// Taris: isIdle follows the current notification through its signal. As a binding through
+	// bNotification it stayed with a deleted notification now and then, and the monitor never
+	// reported idle again once its timeout, enabled state or inhibitor setting had changed.
+	auto guard = qScopeGuard([&, this] {
+		this->bNotification = notification;
+		this->bIsIdle = notification ? notification->bIsIdle.value() : false;
+		if (notification) {
+			QObject::connect(notification, &impl::IdleNotification::isIdleChanged, this, [this, notification] {
+				this->bIsIdle = notification->bIsIdle.value();
+			});
+		}
+	});
 
 	auto params = this->bParams.value();
 
