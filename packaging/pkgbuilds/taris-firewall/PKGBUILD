# TarisOS's firewall: a static nftables ruleset (incoming blocked except replies, outgoing allowed),
# loaded at boot; no daemon runs afterwards. On whenever the package is installed. The
# administrator's own rules go in /etc/taris/firewall.d/*.nft (rule lines of the input chain).

pkgname=taris-firewall
pkgver=1.0.0
pkgrel=3
pkgdesc='TarisOS: a minimal firewall (nftables, nothing running)'
arch=('any')
url='https://github.com/TarisOS/tarisOS'
license=('GPL-3.0-only')
depends=('nftables' 'systemd')
source=('firewall.nft' 'firewall-user.nft' 'taris-firewall.service')
sha256sums=('64469acd32d0648294b0d5955d4488ab029e1a8c7b111d868e36a860c4c2f32b'
            'e06e6972f5aecb09cd2bd3f8bd54f2c445c07dcb337c33f398b0a1228be8607b'
            '1d4e4889b6b6898b75df56f7a61d00280500311acc000fdf84bd22ce1bb1ef2d')

package() {
    install -Dm644 firewall.nft firewall-user.nft -t "$pkgdir/usr/share/taris"
    install -d "$pkgdir/etc/taris/firewall.d"
    install -Dm644 taris-firewall.service -t "$pkgdir/usr/lib/systemd/system"
    install -d "$pkgdir/usr/lib/systemd/system/sysinit.target.wants"
    ln -s ../taris-firewall.service "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/taris-firewall.service"
}
