[Unit]
Description=TarisOS firewall
Wants=network-pre.target
Before=network-pre.target
DefaultDependencies=no
After=local-fs.target
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nft -f /usr/share/taris/firewall.nft
ExecReload=/usr/bin/nft -f /usr/share/taris/firewall.nft
ExecStop=/usr/bin/nft destroy table inet taris_firewall

[Install]
WantedBy=sysinit.target
