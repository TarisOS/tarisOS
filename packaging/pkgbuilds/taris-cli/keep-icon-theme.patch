+def current_icon_theme() -> str | None:
+    # TarisOS: the icon pack picked in Settings (or the session's default), so a new scheme keeps it
+    proc = subprocess.run(
+        ["dconf", "read", "/org/gnome/desktop/interface/icon-theme"], capture_output=True, text=True
+    )
+    return proc.stdout.strip().strip("'") or None
