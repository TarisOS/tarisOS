[Unit]
Description=Install TarisOS's apps that aren't in its image
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/taris/first-apps-done

[Service]
Type=oneshot
ExecStart=/usr/lib/taris/first-apps
