# Firefox, installed the first time it's opened: the launcher and the dock show it
# greyed out until then, and its own entry takes over once it's installed
[Desktop Entry]
Type=Application
Name=Firefox
GenericName=Web Browser
Comment=Browse the web
Exec=/usr/lib/taris/install-on-demand firefox
Icon=firefox
Categories=Network;WebBrowser;
Keywords=firefox;browser;web;
Terminal=false
