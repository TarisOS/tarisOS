# OBS Studio, installed the first time it's opened: the launcher and the dock show it
# greyed out until then, and its own entry takes over once it's installed
[Desktop Entry]
Type=Application
Name=OBS Studio
GenericName=Streaming and Recording
Comment=Record and stream your screen
Exec=/usr/lib/taris/install-on-demand obs
Icon=com.obsproject.Studio
Categories=AudioVideo;Recorder;
Keywords=obs;record;stream;screen;video;
Terminal=false
