# NordVPN, installed on first use: its service and its group for every account
[Trigger]
Type = Package
Operation = Install
Target = nordvpn-bin

[Action]
Description = Setting up NordVPN for every account...
When = PostTransaction
Exec = /usr/lib/taris/nordvpn-setup install
