# LibreOffice Writer, installed the first time it's opened: the launcher and the dock show it
# greyed out until then, and its own entry takes over once it's installed
[Desktop Entry]
Type=Application
Name=LibreOffice Writer
GenericName=Word Processor
Comment=Documents
Exec=/usr/lib/taris/install-on-demand writer
Icon=libreoffice-writer
Categories=Office;WordProcessor;
Keywords=libreoffice;word;doc;docx;odt;
Terminal=false
