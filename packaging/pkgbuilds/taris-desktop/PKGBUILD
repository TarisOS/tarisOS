# This repository's packaging folder (the Hyprland config, defaults, agent skills, title bars)
_packaging="${TARIS_PACKAGING:-$startdir/../..}"

package() {
    local share="$pkgdir/usr/share/taris"

    install -Dm644 "$_packaging/hypr/hyprland.lua" "$_packaging/hypr/taris.lua" -t "$share/hypr"
    install -Dm644 skel-hyprland.lua "$pkgdir/etc/skel/.config/hypr/hyprland.lua"
    # A new account's picture until its owner picks one
    install -Dm644 "$_packaging/defaults/logo/face.png" "$pkgdir/etc/skel/.face"

    install -Dm755 user-defaults name-system update install-on-demand input-method mirrors nordvpn-setup agent-setup -t "$pkgdir/usr/lib/taris"
    # Apps installed the first time they're opened: VSCodium, Steam, OBS Studio, LibreOffice,
    # Firefox and NordVPN (whose service and group are set up when it's installed)
    install -Dm644 taris-install-*.desktop -t "$pkgdir/usr/share/applications"
    # NordVPN's own icon (from its GPL-3.0 nordvpn-linux), under another name than the one its
    # package installs: no other icon theme has it, and the stand-in shows before it's installed
    install -Dm644 taris-install-nordvpn.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
    # Each icon pack Settings offers as a theme of its own, Taris-<pack>, that falls back to the
    # others: an app the pack has no icon for, and that has none of its own (one installed on first
    # use, Tor Browser), shows the icon of the first other pack that has one, Papirus (the most
    # complete) first. GTK and Qt both look in the pack, then in what it inherits (hicolor, apps'
    # own icons, among them), then in the others; a pack that isn't installed is skipped. Hidden
    # from icon theme pickers; GTK skips a theme without Directories, so it has one (empty).
    local packs=(Papirus-Dark Tela-dark WhiteSur-dark Fluent-dark breeze-dark Adwaita) pack other inherits
    for pack in "${packs[@]}"; do
        inherits=$pack
        for other in "${packs[@]}"; do
            [[ $other == "$pack" ]] || inherits+=",$other"
        done
        install -d "$pkgdir/usr/share/icons/Taris-$pack"
        printf '%s\n' '[Icon Theme]' "Name=$pack (Taris)" "Comment=$pack, then the other icon packs" \
            "Inherits=$inherits" 'Hidden=true' 'Directories=apps' '' \
            '[apps]' 'Size=48' 'Type=Scalable' 'MinSize=8' 'MaxSize=512' 'Context=Applications' \
            > "$pkgdir/usr/share/icons/Taris-$pack/index.theme"
    done
    install -Dm755 "$_packaging/titlebars/build-hyprbars" "$pkgdir/usr/lib/taris/build-hyprbars"
    install -Dm644 taris-os-release.hook taris-hyprbars.hook taris-hyprbars-remove.hook taris-nordvpn.hook taris-nordvpn-remove.hook -t "$pkgdir/usr/share/libalpm/hooks"
    install -Dm644 taris-hyprbars.service -t "$pkgdir/usr/lib/systemd/system"
    # The freshest mirrors first, a few minutes after starting up and daily
    install -Dm644 taris-mirrors.service taris-mirrors.timer -t "$pkgdir/usr/lib/systemd/system"
    install -d "$pkgdir/usr/lib/systemd/system/timers.target.wants"
    ln -s ../taris-mirrors.timer "$pkgdir/usr/lib/systemd/system/timers.target.wants/taris-mirrors.timer"
    # The apps that aren't in the image, installed in the background as the first account logs in
    # (the setup screen starts it; the timer tries again until it has worked)
    install -Dm755 first-apps -t "$pkgdir/usr/lib/taris"
    install -Dm644 first-apps.list "$pkgdir/usr/share/taris/first-apps"
    install -Dm644 taris-first-apps.service taris-first-apps.timer -t "$pkgdir/usr/lib/systemd/system"
    ln -s ../taris-first-apps.timer "$pkgdir/usr/lib/systemd/system/timers.target.wants/taris-first-apps.timer"
    install -Dm644 50-taris-mirrors.rules -t "$pkgdir/usr/share/polkit-1/rules.d"
    # NordVPN's daemon stopped while it's disconnected, without a password (the shell's VPN service)
    install -Dm644 50-taris-nordvpn.rules -t "$pkgdir/usr/share/polkit-1/rules.d"
    # Sleep waits up to 15 s for the shell to lock the session, and GNOME's FUSE mounts can't
    # keep it from sleeping (detached before, mounted again after waking)
    install -Dm644 taris-logind.conf "$pkgdir/usr/lib/systemd/logind.conf.d/taris.conf"
    install -Dm644 taris-logind.hook -t "$pkgdir/usr/share/libalpm/hooks"
    install -Dm755 fuse-sleep -t "$pkgdir/usr/lib/taris"
    install -d "$pkgdir/usr/lib/systemd/system-sleep"
    ln -s ../../../lib/taris/fuse-sleep "$pkgdir/usr/lib/systemd/system-sleep/taris-fuse"
    install -Dm644 taris-fuse-resume.service -t "$pkgdir/usr/lib/systemd/system"
    install -d "$pkgdir/usr/lib/systemd/system/suspend.target.wants"
    ln -s ../taris-fuse-resume.service "$pkgdir/usr/lib/systemd/system/suspend.target.wants/taris-fuse-resume.service"
    install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
    ln -s ../taris-hyprbars.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/taris-hyprbars.service"
    install -Dm644 os-release bashrc -t "$share"
    install -Dm644 taris-name.cfg "$pkgdir/etc/default/grub.d/taris-name.cfg"

    install -Dm644 hyprland-portals.conf "$pkgdir/etc/xdg/xdg-desktop-portal/hyprland-portals.conf"
    install -Dm644 mimeapps.list "$pkgdir/etc/xdg/mimeapps.list"
    install -Dm644 xdg-terminals.list "$pkgdir/etc/xdg/xdg-terminals.list"
    install -Dm644 kitty.conf "$pkgdir/etc/xdg/kitty/kitty.conf"
    install -Dm644 mpv.conf "$pkgdir/etc/mpv/mpv.conf"

    install -Dm644 "$_packaging/defaults/taris-theme.json" "$share/defaults/taris-theme.json"
    install -Dm644 "$_packaging/defaults/webapps/list.tsv" "$share/webapps/list.tsv"
    install -Dm644 "$_packaging"/defaults/webapps/icons/*.png -t "$share/webapps/icons"

    # TarisOS's logo as the system's icon (os-release's LOGO)
    local size
    for size in 16 24 32 48 64 128 256 512; do
        install -Dm644 "$_packaging/defaults/logo/taris-$size.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x$size/apps/taris.png"
    done

    # Instructions for coding agents, written for this system: the rules every session reads
    # (agent-setup puts them in each agent's own file) and the skills
    install -Dm644 "$_packaging/agents/rules.md" "$share/agent-rules.md"
    local skill file
    for skill in "$_packaging"/agents/skills/*/; do
        skill=$(basename "$skill")
        for file in "$_packaging/agents/skills/$skill"/*; do
            install -Dm644 "$file" "$share/agent-skills/$skill/$(basename "$file")"
        done
    done
}
