# TarisOS's desktop: Hyprland's settings and the shell's integration (/usr/share/taris/hypr, so
# updates reach them; each account's own changes go on top), the default apps, the desktop portal's
# file picker, a new account's defaults (colours, wallpapers, web apps, agent skills), the window
# title bar plugin and the system's name. Built from this repository's packaging folder.

pkgname=taris-desktop
pkgver=1.0.0
pkgrel=19
pkgdesc='TarisOS: the Hyprland desktop, its defaults and the system name'
arch=('any')
url='https://github.com/TarisOS/tarisOS'
license=('GPL-3.0-only')
depends=(
    'taris-shell'
    'hyprland'
    'xdg-desktop-portal-hyprland'
    'xdg-desktop-portal-gtk'
    'gnome-keyring'
    'polkit'
    'glib2'
    'dconf'
    'xdg-utils'
    'xdg-user-dirs'
    'desktop-file-utils'
    'wl-clipboard'
    'cliphist'
    'adw-gtk-theme'
    'papirus-icon-theme'
    'fluent-icon-theme-git'
    'noto-fonts'
    'noto-fonts-emoji'
    'python'
    'file'
    'curl'
    'bash'

    # Apps that run in a terminal (Neovim, Vim...) open in kitty from Files and the launcher too:
    # GLib only knows a few terminals by name, and asks xdg-terminal-exec first (xdg-terminals.list)
    'xdg-terminal-exec'

    # The title bar plugin, built for each Hyprland installed
    'jq'
    'make'
    'gcc'
    'pkgconf'
    'binutils'
)
optdepends=(
    'taris-wallpapers: the wallpaper collection'
    'chromium: the browser, and the web apps'
)
install=taris-desktop.install
backup=('etc/xdg/kitty/kitty.conf' 'etc/xdg/mimeapps.list' 'etc/xdg/xdg-terminals.list' 'etc/xdg/xdg-desktop-portal/hyprland-portals.conf' 'etc/default/grub.d/taris-name.cfg' 'etc/mpv/mpv.conf')
source=(
    'user-defaults'
    'name-system'
    'os-release'
    'taris-os-release.hook'
    'taris-hyprbars.hook'
    'taris-hyprbars-remove.hook'
    'taris-name.cfg'
    'hyprland-portals.conf'
    'skel-hyprland.lua'
    'bashrc'
    'mimeapps.list'
    'xdg-terminals.list'
    'update'
    'install-on-demand'
    'taris-install-code.desktop'
    'taris-install-steam.desktop'
    'taris-install-obs.desktop'
    'taris-install-writer.desktop'
    'taris-install-calc.desktop'
    'taris-install-impress.desktop'
    'taris-install-firefox.desktop'
    'taris-install-nordvpn.desktop'
    'taris-install-nordvpn.svg'
    'nordvpn-setup'
    'taris-nordvpn.hook'
    'taris-nordvpn-remove.hook'
    'mirrors'
    'taris-mirrors.service'
    'taris-mirrors.timer'
    'first-apps'
    'first-apps.list'
    'taris-first-apps.service'
    'taris-first-apps.timer'
    '50-taris-mirrors.rules'
    '50-taris-nordvpn.rules'
    'input-method'
    'taris-hyprbars.service'
    'kitty.conf'
    'mpv.conf'
    'taris-logind.conf'
    'taris-logind.hook'
    'fuse-sleep'
    'taris-fuse-resume.service'
    'agent-setup'
)
