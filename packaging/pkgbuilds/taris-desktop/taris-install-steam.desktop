# Steam, installed the first time it's opened: the launcher and the dock show it
# greyed out until then, and its own entry takes over once it's installed
[Desktop Entry]
Type=Application
Name=Steam
GenericName=Game Store
Comment=Games from Steam
Exec=/usr/lib/taris/install-on-demand steam
Icon=steam
Categories=Game;
Keywords=games;steam;
Terminal=false
