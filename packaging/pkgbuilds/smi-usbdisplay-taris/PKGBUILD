# Silicon Motion's USB display adapter driver (SMI USB Display 4.3.6.0: its display manager and the
# adapters' firmware), on the system's evdi (evdi-dkms, built by DKMS for the running kernel from
# linux-asahi-headers) instead of the one SiliconMotion bundles, which no longer builds: from
# xxwitcher/SiliconMotion-Driver-Fix. Its udev rule starts the manager when an adapter is plugged in
# and stops it when the last one goes, as SiliconMotion's installer sets it up. The manager calls
# evdi_open_attached_to(NULL), which crashes the system's libevdi: a preloaded shim
# (evdi-nullfix.c) hands that to the call that takes NULL.

pkgname=smi-usbdisplay-taris
_pkgname=SiliconMotion-Driver-Fix
_commit=e81bf12b377d51abfa8e08eea6175ad64eaa6ce4
pkgver=4.3.6.0
pkgrel=1
pkgdesc='Silicon Motion USB display adapter driver, on the system evdi'
arch=('aarch64')
url='https://github.com/xxwitcher/SiliconMotion-Driver-Fix'
license=('LicenseRef-SiliconMotion' 'GPL-3.0-only')
depends=(
    'evdi-dkms'
    'linux-asahi-headers'
    'gcc-libs'
    'glibc'
    'kmod'
    'systemd'
)
provides=('smi-usbdisplay')
conflicts=('smi-usbdisplay')
# SiliconMotion's binaries ship as they are
options=('!strip')
source=("$_pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
        'evdi-nullfix.c'
        'smiusbdisplay.service')
sha256sums=('8686047445a70f5a6f1d0be6da0725b1e5f41e44fdef0a0ad54ef1a210544bbb'
            'aa033263ec6c1f180a105ad8bf091e5a7aa52d068f3fc08cc791eb3a3878bdb7'
            'ceffbfd3ba338245125a887c666c5f8d5b1c79c1f0171778f2e329988328742c')

build() {
    # Not linked to libevdi: its one call resolves from the libevdi the manager loads (the service
    # preloads it into the manager alone), so building needs no evdi-dkms (built after this package)
    gcc $CPPFLAGS $CFLAGS -shared -fPIC $LDFLAGS -o libevdi-nullfix.so evdi-nullfix.c
}

package() {
    local dir="$pkgdir/opt/siliconmotion"
    cd "$_pkgname-$_commit"

    # The manager finds its libusb next to itself (RUNPATH $ORIGIN), and its firmware in its
    # working directory
    install -Dm755 aarch64/SMIUSBDisplayManager aarch64/libusb-1.0.so.0.2.0 "$srcdir/libevdi-nullfix.so" -t "$dir"
    ln -s libusb-1.0.so.0.2.0 "$dir/libusb-1.0.so.0"
    install -Dm644 Bootloader0.bin Bootloader1.bin firmware0.bin USBDisplay.bin USBDisplay770.bin -t "$dir"
    install -d "$pkgdir/var/log/SMIUSBDisplay"

    # The udev rule and the script it runs, as SiliconMotion's installer writes them
    (
        . ./smi-udev-installer.sh
        create_udev_rules_file "$pkgdir/usr/lib/udev/rules.d/99-smiusbdisplay.rules"
        create_bootstrap_file systemd "$dir/smi-udev.sh"
    )
    install -Dm644 "$srcdir/smiusbdisplay.service" -t "$pkgdir/usr/lib/systemd/system"

    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
