--- a/lib/Emulation.cpp	2026-01-26 13:52:32.000000000 +0000
+++ b/lib/Emulation.cpp	2026-10-13 19:48:16.603832853 +0100
@@ -316,8 +316,27 @@
     return _currentScreen->getLines() + _currentScreen->getHistLines();
 }
 
+// Taris: every update redraws the terminal in the shell and the compositor (the shell's whole
+// screen for its overlay terminal, the Agent tab's surface for that one). While a program streams
+// output, show its screen at most ~30 times a second (still immediate to the eye) instead of up to
+// ~100, and ~15 times a second while the user isn't typing (an agent working on its own: its
+// spinner and its output, at half the cost in the shell, the compositor and the battery).
+static const int MIN_BULK_INTERVAL = 33;
+static const int IDLE_BULK_INTERVAL = 66;
+// How long after a key press, a paste or a click the screen keeps the full rate
+static const int INPUT_FULL_RATE = 500;
+
 void Emulation::showBulk()
 {
+    const int interval = _lastInput.isValid() && _lastInput.elapsed() < INPUT_FULL_RATE ? MIN_BULK_INTERVAL : IDLE_BULK_INTERVAL;
+    if (_lastBulk.isValid() && _lastBulk.elapsed() < interval)
+    {
+        _bulkTimer1.setSingleShot(true);
+        _bulkTimer1.start(interval - static_cast<int>(_lastBulk.elapsed()));
+        return;
+    }
+    _lastBulk.start();
+
     _bulkTimer1.stop();
     _bulkTimer2.stop();
 
