[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Operation = Remove
Target = *

[Action]
Description = Taking a snapshot before changing packages...
When = PreTransaction
Depends = snapper
Exec = /usr/lib/taris/snapshot pre
