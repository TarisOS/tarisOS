# The list of backups Settings reads, at every start: after a restore, the one in the restored
# system is the backup's own
[Unit]
Description=Listing TarisOS's backups
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/lib/taris/backup index
