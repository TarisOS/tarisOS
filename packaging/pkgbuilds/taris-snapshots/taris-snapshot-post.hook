[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Operation = Remove
Target = *

[Action]
Description = Keeping the last 10 snapshots...
When = PostTransaction
Depends = snapper
Exec = /usr/lib/taris/snapshot post
