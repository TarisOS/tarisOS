# TarisOS's snapshots, backups and factory reset: snapper's settings for the root (a snapshot before
# every package change, the last 10 kept), backups of the whole system (/usr/lib/taris/backup: made
# from Settings or on a schedule, at most 20, restored from the initramfs at the next boot) and the
# factory reset, which brings back @factory (the system as installed) the same way.

pkgname=taris-snapshots
pkgver=1.0.0
pkgrel=2
pkgdesc='TarisOS: snapshots before package changes, backups, and factory reset'
arch=('any')
url='https://github.com/TarisOS/tarisOS'
license=('GPL-3.0-only')
depends=('snapper' 'btrfs-progs' 'mkinitcpio' 'util-linux' 'bash')
backup=('etc/mkinitcpio.conf.d/taris-reset.conf' 'etc/taris/factory-reset.keep')
source=(
    'snapper-taris'
    'snapshot'
    'taris-snapshot-pre.hook'
    'taris-snapshot-post.hook'
    'factory-reset'
    'initcpio-install'
    'initcpio-hook'
    'taris-reset.conf'
    'factory-reset.keep'
    'backup'
    'taris-backups.service'
    'taris-backups-auto.service'
    'taris-backups-auto.timer'
)
sha256sums=('d17f3d350a3054e53e1048f011eed6f862deb7277b29662f8d77f4f535a8b31f'
            'c0a877687760de491c2312a55ab4f322ab0fa9c44b907b18f7f3ed2f2f045fd0'
            'f659216ba093848f23871545857652919fd66761e325ca76dd898cf4bb20954d'
            '006f88e74df7b833f5a4713fcc88cf9d518512cc7ba621a262fdf18d868baeeb'
            '63ba81703525d5722a3e4947202f958c6c7c1cb67b7a6e6403db7e40e54e73ad'
            '178fafd356f3228652877b4bea25e7f35a5f506b306b0b2bda75cf99cf3c9818'
            'c0520a2927c0db124d11eae66a97e91f75d85e7364da1024e0d1f63643a23e48'
            'e941adca0c440a9315ad0882811803a5ecbb3da00b3bfc9ecd310b43a906408e'
            '783a4709ef16d110e4214deffe1f6f371456abd9d75ce875741dfdf4f65bb1fe'
            '39cc7b9354a59eab4b078e65a6dc09694a2388a2905d90e00be48dc314190d4c'
            '45dfa8ef468a252f1591ee063b268de8662ca1a8062d2028773e0297cba88ccd'
            '4aa7b593990e9b363e93a3afcf5a7e8cfd365c69038937677478f4c00d020074'
            '3c11319b3a7c7a20ec69919152e059b5e179c7a79c8199cf4a0968e7a56ff590')

package() {
    install -Dm644 snapper-taris "$pkgdir/usr/share/snapper/config-templates/taris"
    install -Dm755 snapshot factory-reset backup -t "$pkgdir/usr/lib/taris"
    # The backups' list at every start, and the daily check for an automatic backup
    install -Dm644 taris-backups.service taris-backups-auto.service taris-backups-auto.timer -t "$pkgdir/usr/lib/systemd/system"
    install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants" "$pkgdir/usr/lib/systemd/system/timers.target.wants"
    ln -s ../taris-backups.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/taris-backups.service"
    ln -s ../taris-backups-auto.timer "$pkgdir/usr/lib/systemd/system/timers.target.wants/taris-backups-auto.timer"
    install -Dm644 taris-snapshot-pre.hook "$pkgdir/usr/share/libalpm/hooks/00-taris-snapshot-pre.hook"
    install -Dm644 taris-snapshot-post.hook "$pkgdir/usr/share/libalpm/hooks/zz-taris-snapshot-post.hook"
    install -Dm644 initcpio-install "$pkgdir/usr/lib/initcpio/install/taris-reset"
    install -Dm644 initcpio-hook "$pkgdir/usr/lib/initcpio/hooks/taris-reset"
    install -Dm644 taris-reset.conf "$pkgdir/etc/mkinitcpio.conf.d/taris-reset.conf"
    install -Dm644 factory-reset.keep "$pkgdir/etc/taris/factory-reset.keep"
}
